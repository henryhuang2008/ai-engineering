# Chat model: any OpenAI-compatible endpoint. DeepSeek is the course default.
OPENAI_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Where the SQLite file lives, relative to this folder.
SQL_DB_PATH=data/northstar.db

# Generated queries to try before the graph gives up.
MAX_ATTEMPTS=3
