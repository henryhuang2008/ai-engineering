# Chat model: any OpenAI-compatible endpoint. DeepSeek is the course default.
OPENAI_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Long-term memory persistence: leave empty to use InMemorySaver/InMemoryStore.
# With a value, `--postgres` uses PostgresSaver + PostgresStore.
DATABASE_URL=

# Optional embedding provider for semantic recall. Without it, recall lists
# facts without similarity ranking (LangGraph returns score=None).
EMBED_MODEL=
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_DIMS=1536

# Short-term memory bounds.
MAX_CONTEXT_TOKENS=2000
KEEP_LAST_MESSAGES=6
RECALL_LIMIT=5
