# Chat model: any OpenAI-compatible endpoint. DeepSeek is the course default.
OPENAI_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# The skill library: the parent of the skill packages, not a skill itself.
SKILLS_DIR=skills

# Refuse read_skill_resource / run_skill_script for a skill that is not loaded.
REQUIRE_LOADED=1
